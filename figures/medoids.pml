delete raw_c7_5TM1_A
python
cmd.transform_object('c7_5TM1_A', [0.71601464, -0.38110077, 0.58488054, -2.29602585, -0.35661297, -0.91994798, -0.16285852, 1.79357696, 0.60012518, -0.0919669, -0.7946017, 26.0161089, 0.0, 0.0, 0.0, 1.0], state=1, homogenous=1, transpose=0)
python end
