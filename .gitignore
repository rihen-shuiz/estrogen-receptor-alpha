# Bulk data, rebuilt by scripts/fetch_data.py and scripts/clean_chain_pdbs.py.
# ID lists, the ChEMBL export and raw download metadata stay tracked.
data/raw/*
!data/raw/download_manifest.csv
!data/raw/sha256sums.txt
data/ccd/
data/clean/
data/lbd/

# Python bytecode
__pycache__/

# Tracker bundles (include environment details)
tracker/bundle_*.zip

# Final run (2026-10-25): re-downloadable bulk inputs (scripts/rebuild_fetch_raw.py, scripts/ext_esr2.py)
results/rebuild/raw/
results/rebuild/ccd/
data/cache/esr2_cif/

# Final pack (>100 MB, GitHub limit); rebuild with: python scripts/make_final_pack.py
final_pack_*.zip

# RUN_SV1028 (docs/sv/RUN_SV1028.md): large regenerable arrays under data/sv, rebuilt from data/raw by
